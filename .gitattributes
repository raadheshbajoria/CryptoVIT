# Normalize line endings to LF in the repository
* text=auto eol=lf

# Explicitly declare text files
*.py text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.txt text eol=lf

# Binary files — do not touch
*.pt binary
*.npy binary
*.gz binary
*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
